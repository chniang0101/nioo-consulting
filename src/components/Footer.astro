---
import { contact, links } from '../config';
import { content, routes, type Lang, type PageKey } from '../i18n';

interface Props {
  lang?: Lang;
  page?: PageKey;
}
const { lang = 'fr', page = 'home' } = Astro.props;
const t = content[lang].footer;
const year = new Date().getFullYear();
const legalUrl = routes.legal[lang];
---

<footer class="site-footer on-dark">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img
        src="/brand/nioo-logo-horizontal-dark.svg"
        alt="Nioo Consulting"
        width="180"
        height="42"
      />
      <p class="footer-note">{t.note} · {contact.email}</p>
    </div>

    <nav class="footer-links" aria-label="Contact">
      <a href={links.mailto}>E-mail</a>
      <a href={links.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
      {links.linkedin && (
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      )}
      {links.malt && (
        <a href={links.malt} target="_blank" rel="noopener">Malt</a>
      )}
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>{t.copyright(year)} · <a href={legalUrl}>{t.legal}</a></p>
    <p class="trademark">{t.trademark}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--plum-night);
    color: var(--plum-pale);
    padding-block: clamp(40px, 6vw, 64px);
    border-top: 1px solid rgba(233, 217, 230, 0.1);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(233, 217, 230, 0.12);
  }

  .footer-brand img {
    height: 36px;
    width: auto;
    margin-bottom: 0.75rem;
  }

  .footer-note {
    margin: 0;
    color: var(--plum-pale);
    opacity: 0.75;
    font-size: 0.95rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-links a {
    color: var(--turquoise-light);
    font-weight: 500;
  }

  .footer-links a:hover {
    color: #fff;
  }

  .footer-bottom {
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: 0.88rem;
    color: var(--plum-pale);
    opacity: 0.7;
  }

  .footer-bottom a {
    color: var(--turquoise-light);
  }

  .trademark {
    margin: 0;
    max-width: 48ch;
  }

  .footer-bottom p {
    margin: 0;
  }
</style>
