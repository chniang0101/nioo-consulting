---
import { content, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'fr' } = Astro.props;
const t = content[lang].services;
---

<section id="services">
  <div class="container flow">
    <div class="section-head">
      <span class="node" data-node aria-hidden="true"></span>
      <h2>{t.heading}</h2>
    </div>

    <div class="odoo-block">
      <h3>{t.odooTitle}</h3>
      <dl class="service-list">
        {
          t.odoo.map((s) => (
            <div class="service-item">
              <dt>{s.title}</dt>
              <dd>{s.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="complementaires">
      <h3>{t.extraTitle}</h3>
      <dl class="service-list small">
        {
          t.extra.map((s) => (
            <div class="service-item">
              <dt>{s.title}</dt>
              <dd>{s.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Bloc Odoo dominant : fond légèrement teinté, coins arrondis */
  .odoo-block {
    margin-bottom: clamp(24px, 3vw, 36px);
    background: #f3ecf2;
    border-radius: 12px;
    padding: clamp(24px, 3.5vw, 40px);
  }

  .odoo-block h3 {
    color: var(--plum);
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    margin-bottom: 1.5rem;
  }

  .complementaires h3 {
    color: var(--plum);
    font-size: 1.05rem;
    margin-bottom: 1.1rem;
  }

  .service-list {
    margin: 0;
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  @media (min-width: 720px) {
    .service-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service-item {
    border-left: 2px solid var(--turquoise-soft);
    padding-left: 1rem;
  }

  .service-item dt {
    font-weight: 600;
    color: var(--plum);
    font-size: 1.12rem;
    margin-bottom: 0.3rem;
  }

  .odoo-block .service-item dt {
    font-size: 1.2rem;
  }

  .service-item dd {
    margin: 0;
    color: var(--text-muted);
  }

  .complementaires {
    padding-top: clamp(24px, 3vw, 36px);
    border-top: 1px solid var(--border);
  }

  .service-list.small .service-item dt {
    font-size: 1.05rem;
  }
</style>
