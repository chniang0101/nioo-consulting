---
import { content, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'fr' } = Astro.props;
const t = content[lang].methode;
---

<section id="methode">
  <div class="container flow">
    <div class="section-head">
      <span class="node" data-node aria-hidden="true"></span>
      <h2>{t.heading}</h2>
    </div>

    <ol class="steps">
      {
        t.steps.map((e, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3>{e.titre}</h3>
              <p>{e.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.5vw, 28px);
    position: relative;
  }

  /* Fine ligne verticale reliant les cercles numérotés */
  .steps::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 1.2rem;
    bottom: 1.2rem;
    width: 2px;
    background: var(--turquoise);
    transform: translateX(-1px);
    z-index: 0;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    position: relative;
    z-index: 1;
  }

  .step-num {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 2px solid var(--turquoise);
    background: var(--off-white);
    color: var(--plum);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .step h3 {
    margin: 0.25rem 0 0.2rem;
    font-size: 1.12rem;
  }

  .step p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
