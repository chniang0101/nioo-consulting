---
import { content, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'fr' } = Astro.props;
const t = content[lang].hero;
---

<section class="hero" id="top">
  <div class="container flow hero-grid">
    <!-- Colonne droite : le N (premier nœud du fil) puis les étiquettes
         enfilées le long du fil à sa sortie du N. En premier dans le DOM
         pour que l'ordre des nœuds du fil commence bien par le N. -->
    <div class="hero-side">
      <figure class="hero-mark">
        <img
          src="/brand/nioo-icon-plum-transparent.svg"
          alt={t.markAlt}
          width="220"
          height="220"
        />
        <span class="node hero-start" data-node="free" aria-hidden="true"></span>
      </figure>

      <ul class="hero-connections" aria-label={t.connectionsLabel}>
        {
          t.connections.map((c) => (
            <li>
              <span class="node" data-node="free" aria-hidden="true" />
              {c}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-text">
      <h1>{t.title}</h1>
      <p class="lead">{t.lead}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#contact">{t.ctaPrimary}</a>
        <a class="btn btn-secondary" href="#realisations">{t.ctaSecondary}</a>
      </div>
    </div>
  </div>

  <p class="container flow trust">{t.trust}</p>
</section>

<style>
  .hero {
    padding-top: clamp(32px, 5vw, 56px);
    padding-bottom: clamp(24px, 4vw, 40px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: center;
  }

  .hero-text {
    grid-column: 1;
    grid-row: 1;
  }

  .hero-side {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: clamp(0px, 4vw, 48px);
  }

  .hero-mark {
    position: relative;
    margin: 0 0 0.5rem;
  }

  .hero-mark img {
    height: clamp(150px, 19vw, 210px);
    width: auto;
    display: block;
  }

  /* Nœud de départ du fil : extrémité bas-droite du N (70% / 78%) */
  .hero-start {
    position: absolute;
    left: 70%;
    top: 78%;
    transform: translate(-50%, -50%);
  }

  /* Les étiquettes descendent sous le N, alignées avec son nœud bas-droit */
  .hero-connections {
    list-style: none;
    margin: 0;
    padding: 0 0 0 calc(70% * 0.42);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    color: var(--text-muted);
    font-size: 0.98rem;
  }

  .hero-connections li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  h1 {
    margin-bottom: 0.4em;
  }

  .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    color: var(--text);
    max-width: 44ch;
    margin-bottom: 1.6rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .trust {
    margin-top: clamp(20px, 3vw, 32px);
    color: var(--text-muted);
    font-size: 0.95rem;
    border-top: 1px solid var(--border);
    padding-top: 1.1rem;
  }

  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    /* Le titre d'abord, puis le N et ses étiquettes */
    .hero-text {
      grid-column: 1;
      grid-row: 1;
    }

    .hero-side {
      grid-column: 1;
      grid-row: 2;
      align-items: flex-start;
      padding-left: 0;
    }

    .hero-mark img {
      height: 120px;
    }

    .hero-connections {
      padding-left: calc(70% * 0.3);
    }
  }
</style>
