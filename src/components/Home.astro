---
// Contenu de la page d'accueil, partagé entre /fr et /en.
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Thread from './Thread.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Realisations from './Realisations.astro';
import Methode from './Methode.astro';
import APropos from './APropos.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Layout lang={lang} page="home">
  <Header lang={lang} page="home" />
  <main id="main" class="thread-wrap">
    <Thread />
    <Hero lang={lang} />
    <Services lang={lang} />
    <Realisations lang={lang} />
    <Methode lang={lang} />
    <APropos lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} page="home" />
</Layout>
